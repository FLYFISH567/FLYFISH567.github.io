<section class="opening-screen" aria-label="欢迎来到 FLYFISHING" hidden>
  <div class="opening-content">
    <div class="opening-avatar"><span class="brand-mark" aria-hidden="true"></span><img src="<%= theme.avatar %>" alt="" width="80" height="80" decoding="async"><i aria-hidden="true"></i></div>
    <p class="opening-name"><%= config.title %></p>
    <p class="opening-motto"><%= config.subtitle %></p>
  </div>
  <button class="opening-skip" type="button" data-skip-opening>进入博客 <span aria-hidden="true">↵</span></button>
</section>
