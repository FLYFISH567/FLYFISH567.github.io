<%# 相册自动足迹来自 source/_data/album.yml；独立标点来自 source/_data/footprints.yml。 %>
<% const map=ff_travel_map(); const visited=map.places.filter(place=>place.status!=='planned'), planned=map.places.filter(place=>place.status==='planned'); if(map.places.length) { %>
<section class="about-footprints" aria-labelledby="footprints-title">
  <div class="section-heading"><div><span class="eyebrow">FOOTPRINTS & WISHES</span><h2 id="footprints-title">足迹与远方</h2></div><span class="footprints-count">已到访 <%= visited.length %> · 心愿 <%= planned.length %></span></div>
  <p class="footprints-intro">一边收藏走过的风景，一边期待下一次出发。</p>
  <div class="travel-map-shell pointer-surface" data-travel-map data-pointer-light>
    <div class="travel-map-filters" data-map-filters role="group" aria-label="筛选旅行地点" hidden>
      <% for(const filter of [{value:'all',label:'全部',count:map.places.length},{value:'visited',label:'已到访',count:visited.length},{value:'planned',label:'心愿目的地',count:planned.length}]) { %><button type="button" data-map-filter="<%= filter.value %>" aria-pressed="<%= filter.value==='all' %>"><%= filter.label %><span><%= filter.count %></span></button><% } %>
    </div>
    <div class="travel-map-canvas">
      <div class="travel-map-tools" data-map-tools hidden role="group" aria-label="地图缩放"><button type="button" data-map-zoom="in" aria-label="放大地图" title="放大">+</button><button type="button" data-map-zoom="out" aria-label="缩小地图" title="缩小" disabled>−</button><button type="button" data-map-reset aria-label="恢复全国视图" title="恢复全国视图">复位</button><output data-map-scale aria-live="polite">100%</output></div>
      <svg class="travel-map" viewBox="0 0 800 600" tabindex="0" role="group" aria-labelledby="travel-map-title travel-map-description" aria-describedby="travel-map-help">
        <title id="travel-map-title">中国旅行足迹与心愿目的地</title><desc id="travel-map-description">蓝色实心点为已到访，金色空心点为心愿目的地。<% if(visited.some(place=>place.point)) { %>已到访：<%= visited.filter(place=>place.point).map(place=>place.city).join('、') %>。<% } %><% if(planned.some(place=>place.point)) { %>心愿目的地：<%= planned.filter(place=>place.point).map(place=>place.city).join('、') %>。<% } %>有记录链接的标点可以点击，完整地点及备注也显示在旁边的列表中。</desc>
        <defs><clipPath id="travel-main-clip"><rect width="800" height="580"/></clipPath><clipPath id="travel-sea-clip"><rect x="645" y="365" width="135" height="205" rx="6"/></clipPath>
          <g id="travel-land"><% for(const region of map.regions) { %><path class="travel-region" data-region="<%= region.code %>" d="<%= region.path %>" fill-rule="evenodd"/><% } %></g>
        </defs>
        <g clip-path="url(#travel-main-clip)" aria-hidden="true"><use href="#travel-land"/></g>
        <g class="travel-sea" aria-hidden="true"><rect x="645" y="365" width="135" height="205" rx="6"/><g clip-path="url(#travel-sea-clip)"><use href="#travel-land" transform="translate(423 90) scale(.55)"/></g><text x="712" y="555" text-anchor="middle">南海诸岛</text></g>
        <% for(const place of map.places.filter(place=>place.point)) { const [x,y]=place.point; %>
          <<%= place.url?'a':'g' %> class="travel-pin" data-place="<%= place.id %>" data-status="<%= place.status %>" <% if(place.url) { %>href="<%= ff_safe_url(place.url) %>"<% } else { %>tabindex="0" role="img"<% } %> aria-label="<%= place.city %>，<%= place.status==='planned'?'心愿目的地':'已到访' %><%= place.count?'，'+place.count+' 张照片':'' %><%= place.url?'，查看记录':'' %>"><title><%= place.city %> · <%= place.status==='planned'?'心愿目的地':'已到访' %><%= place.date?' · '+place.date:'' %><%= place.note?' · '+place.note:'' %></title><circle class="pin-hit" cx="<%= x %>" cy="<%= y %>" r="22"/><circle class="pin-halo" cx="<%= x %>" cy="<%= y %>" r="14"/><% if(place.status==='planned') { %><circle class="pin-wish-ring" cx="<%= x %>" cy="<%= y %>" r="9"/><% } %><circle class="pin-core" cx="<%= x %>" cy="<%= y %>" r="5"/><text x="<%= x %>" y="<%= y-22 %>" text-anchor="middle"><%= place.city %></text></<%= place.url?'a':'g' %>>
        <% } %>
      </svg>
      <p class="travel-map-help" id="travel-map-help">双击放大 · 放大后可拖动 · 复位查看全国</p>
      <div class="travel-map-caption"><div class="travel-map-legend"><span><i aria-hidden="true"></i>已到访</span><span class="wish-legend"><i aria-hidden="true"></i>心愿目的地</span></div><a href="https://datav.aliyun.com/portal?tool=atlas" target="_blank" rel="noopener">底图：DataV GeoAtlas</a></div>
    </div>
    <nav class="travel-places" aria-label="已到访与心愿目的地，各按日期排列"><% for(const group of [{name:'已到访',status:'visited',places:visited},{name:'心愿目的地',status:'planned',places:planned}]) { %><section class="travel-place-group" data-travel-group="<%= group.status %>" aria-label="<%= group.name %>"><h3 class="travel-places-title"><%= group.name %><span><%= group.places.length %></span></h3><% if(!group.places.length) { %><p class="travel-places-empty"><%= group.status==='planned'?'下一站，还在期待中。':'旅途的故事，慢慢积攒。' %></p><% } %><% for(const place of group.places) { %><<%= place.url?'a':'article' %> class="travel-stop" data-place="<%= place.id %>" data-status="<%= place.status %>" <% if(place.url) { %>href="<%= ff_safe_url(place.url) %>"<% } %>><div><span class="travel-stop-dot" aria-hidden="true"></span><h3><%= place.city %></h3></div><p><%= place.region %><% if(place.date) { %> · <%= place.status==='planned'?'计划于 ':'' %><time><%= place.date %></time><% } %></p><% if(place.note) { %><p class="travel-stop-note"><%= place.note %></p><% } %><small><%= place.status==='planned'?'心愿清单':place.count?place.count+' 张照片':'旅行标记' %><% if(place.status!=='planned'&&place.visits>1) { %> · <%= place.visits %> 次记录<% } %><% if(!place.point) { %> · 暂未标点<% } %></small></<%= place.url?'a':'article' %>><% } %></section><% } %><a class="about-link" href="<%= url_for('/album/') %>">全部相册</a></nav>
  </div>
</section>
<% } %>
