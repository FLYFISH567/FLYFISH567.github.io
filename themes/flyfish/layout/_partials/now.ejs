<% const now=ff_now(); if(now.items?.length) { %>
<section class="about-now" aria-labelledby="now-title">
  <div class="section-heading"><div><span class="eyebrow">NOW</span><h2 id="now-title">最近在做</h2></div><% if(now.updated) { %><time datetime="<%= now.updated %>">更新于 <%= date(now.updated,'YYYY.MM.DD') %></time><% } %></div>
  <div class="now-grid"><% for(const item of now.items) { %>
    <article class="now-card pointer-surface" data-pointer-light><span class="now-label"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><% if(item.icon==='book') { %><path d="M3 5c4-1 6 0 9 2 3-2 5-3 9-2v14c-4-1-6 0-9 2-3-2-5-3-9-2ZM12 7v14"/><% } else if(item.icon==='music') { %><path d="M9 18V5l12-2v13M9 9l12-2"/><ellipse cx="6" cy="18" rx="3" ry="2.5"/><ellipse cx="18" cy="16" rx="3" ry="2.5"/><% } else { %><path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z"/><% } %></svg><%= item.label %></span><h3><%= item.title %></h3><p><%= item.text %></p></article>
  <% } %></div>
</section>
<% } %>
