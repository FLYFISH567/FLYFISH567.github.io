<%# 说说内容：source/_data/essay.yml 的 essay_list；日期、地点、图片、相关链接都在每条记录中维护。 %>
<header class="page-heading illustrated-heading pointer-surface" data-pointer-light><span class="eyebrow">MOMENTS</span><h1>说说</h1><p>随手记下的几句话。</p><%- partial('_partials/heading-art',{kind:'essay'}) %></header>
<%- partial('life-nav') %>
<div class="essay-list"><% for(const entry of ff_essays()) { %><article class="essay-card daily-entry pointer-surface" data-pointer-light><header><time datetime="<%= date(entry.date,'YYYY-MM-DD') %>"><%= date(entry.date,'YYYY.MM.DD') %></time><% if(entry.address) { %><span><%= entry.address %></span><% } %></header><p><%= entry.content %></p><% if(entry.image?.length) { %><div class="essay-images"><% for(const img of entry.image) { %><a href="<%= ff_safe_url(img) %>" data-lightbox="essays" data-caption="<%= entry.content %>"><img src="<%= ff_safe_url(img) %>" alt="<%= entry.content %>" loading="lazy" decoding="async"></a><% } %></div><% } %><% if(entry.video) { %><video controls preload="none" src="<%= ff_safe_url(typeof entry.video==='string'?entry.video:'') %>"></video><% } %><% if(entry.link) { %><a class="text-link" href="<%= ff_safe_url(entry.link) %>" target="_blank" rel="noopener">看看相关内容</a><% } %></article><% } %></div>
