<section class="home-intro" aria-label="欢迎来到 FLYFISHING">
  <div class="intro-copy"><span class="eyebrow">FLYFISH / PERSONAL BLOG</span><h1><% const clauses=theme.hero_title.split('，'); %><%= clauses[0] %><% if(clauses.length>1) { %>，<br><%= clauses.slice(1).join('，') %><% } %></h1>
    <div class="intro-actions">
      <a class="button primary" data-pointer-light href="<%= url_for('/articles/') %>"><span class="action-label">翻翻我的笔记</span><span class="action-icon" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6"/></svg></span></a>
      <button type="button" class="button" data-open-explore data-explore-mode="idea" hidden>抽个灵感 <span aria-hidden="true">✦</span></button>
      <a class="button intro-about" href="<%= url_for('/about/') %>"><span class="action-label">认识一下我</span></a>
    </div>
  </div>
  <a class="sky-cover" data-pointer-light href="<%= url_for('/album/') %>"><img src="<%= url_for(theme.hero_image) %>" <% if(theme.hero_image_srcset) { %>srcset="<%= theme.hero_image_srcset %>" sizes="(max-width: 610px) calc(100vw - 36px), (max-width: 1280px) 57vw, 740px"<% } %> alt="蓝天、白云与天台" fetchpriority="high" decoding="async" width="1600" height="866"><div><strong>普通日子，也有好风景</strong></div></a>
</section>
