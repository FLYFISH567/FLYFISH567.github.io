<%# 个人资料、番剧与游戏：source/_data/about.yml；近期状态：source/_data/now.yml。 %>
<% const about=ff_about(), stories=about.comic?.comic_list || [], game=about.game; %>
<header class="about-intro pointer-surface" data-pointer-light aria-labelledby="about-title">
  <div class="about-intro-main"><div class="about-identity">
    <img class="about-portrait" src="<%= theme.avatar %>" alt="<%= about.name || config.author %> 的头像" width="112" height="112" decoding="async">
    <div><span class="eyebrow">A LITTLE ABOUT ME</span><h1 id="about-title">你好，我是 <%= about.name || config.author %></h1><p class="about-motto"><%= about.subtitle %></p></div>
  </div>
  <p class="about-introduction">我是一名学生。在这里整理学习笔记，收藏照片、音乐和生活中的片刻。写下来，是为了以后还能回头看看。</p>
  <nav class="social-links about-social" aria-label="联系我">
    <a href="<%= theme.github %>" target="_blank" rel="noopener" aria-label="GitHub（新标签页打开）"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 19c-4 1-4-2-5-2m10 4v-3.1c0-.9.3-1.5.7-1.9 2.4-.3 4.9-1.2 4.9-5.4 0-1.2-.4-2.2-1.1-2.9.1-.3.5-1.4-.1-2.9 0 0-.9-.3-3 1.1a10.3 10.3 0 0 0-5.5 0c-2.1-1.4-3-1.1-3-1.1-.6 1.5-.2 2.6-.1 2.9-.7.7-1.1 1.7-1.1 2.9 0 4.2 2.5 5.1 4.9 5.4.3.3.6.8.6 1.5V21"/></svg>GitHub</a>
    <a href="<%= theme.bilibili %>" target="_blank" rel="noopener" aria-label="Bilibili（新标签页打开）"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="8" width="16" height="12" rx="3"/><path d="m8 4 3 4m5-4-3 4M8 13v2m8-2v2"/></svg>Bilibili</a>
    <a href="mailto:flyfish567@qq.com"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>写封邮件</a>
  </nav></div>
  <aside class="about-daily" aria-labelledby="daily-title">
    <div class="about-daily-top"><span class="eyebrow" id="daily-title">今日一句</span><span class="about-daily-sparkle" aria-hidden="true">✦</span></div>
    <div class="about-daily-content"><p class="about-daily-quote" data-daily-quote>慢慢来，生活自有它的节奏。</p><span class="about-daily-attribution" data-daily-attribution>小站手记 · 原创</span></div>
    <div class="about-daily-bottom"><span>给今天一点好心情</span><time data-daily-date></time></div>
  </aside>
</header>
<nav class="about-chapters" aria-label="关于页章节"><a href="#now-title"><span aria-hidden="true">01</span>最近在做</a><a href="#favourites-title"><span aria-hidden="true">02</span>动漫与游戏</a><a href="#footprints-title"><span aria-hidden="true">03</span>足迹与远方</a></nav>
<%- partial('_partials/now') %>
<% if(stories.length || game?.game_title) { %>
<section class="about-favourites" aria-labelledby="favourites-title">
  <div class="section-heading"><div><span class="eyebrow">OFF THE CLOCK</span><h2 id="favourites-title">动漫与游戏</h2></div></div>
  <div class="about-interest-grid <%= stories.length && game?.game_title ? '' : 'single-interest' %>">
    <% if(stories.length) { %>
    <section class="about-anime" aria-labelledby="anime-title">
      <div class="about-interest-heading"><h3 id="anime-title">喜欢的故事</h3><a class="section-link" href="<%= url_for('/bangumis/') %>">全部追番 <span class="about-link-chevron" aria-hidden="true">›</span></a></div>
      <div class="about-stories"><% for(const item of stories) { %><a class="about-story" href="<%= ff_safe_url(item.href) %>" target="_blank" rel="noopener" aria-label="<%= item.name %>（新标签页打开）"><div><img src="<%= ff_safe_url(item.cover) %>" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer"><span class="about-story-peek" aria-hidden="true">查看故事</span></div><h4><%= item.name %></h4></a><% } %></div>
    </section>
    <% } %>
    <% if(game?.game_title) { %>
    <section class="about-games" aria-labelledby="games-title">
      <div class="about-interest-heading"><h3 id="games-title">常玩的游戏</h3></div>
      <article class="about-game-card">
        <div class="about-game-cover">
          <svg class="about-game-fallback" width="100" height="80" viewBox="0 0 100 80" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M33 22h34c12 0 19 10 22 26l2 9c2 12-9 17-17 8L63 54H37L26 65c-8 9-19 4-17-8l2-9c3-16 10-26 22-26Z"/><path d="M29 33v15m-7-7h14"/><circle cx="67" cy="35" r="2"/><circle cx="77" cy="44" r="2"/><path d="M43 23v-8h14v8"/></svg>
          <% if(game.game_bg) { %><img src="<%= ff_safe_url(game.game_bg) %>" alt="<%= game.game_title %>游戏画面" loading="lazy" decoding="async" referrerpolicy="no-referrer"><% } %>
          <span class="about-game-badge">换个节奏，玩一局</span>
        </div>
        <div class="about-game-copy"><span class="eyebrow">PLAYER / FLYFISH</span><h4><%= game.game_title %></h4><% if(game.game_uid) { %><p><%= game.game_uid %></p><% } %><% if(game.href || game.herf) { %><a class="section-link" href="<%= ff_safe_url(game.href || game.herf) %>" target="_blank" rel="noopener" aria-label="访问游戏官网（新标签页打开）">访问游戏官网 <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M9 3h4v4M13 3 7 9M12 9v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h3"/></svg></a><% } %></div>
      </article>
    </section>
    <% } %>
  </div>
  <div class="about-interest-notes">
    <a href="<%= url_for('/music/') %>" class="about-interest-note"><span class="about-note-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13M9 9l12-2"/><ellipse cx="6" cy="18" rx="3" ry="2.5"/><ellipse cx="18" cy="16" rx="3" ry="2.5"/></svg></span><span><strong><%= about.music?.music_title || '日语流行' %></strong></span><span class="about-note-action">去音乐馆 <span class="about-play" aria-hidden="true">▶</span></span></a>
    <div class="about-interest-note"><span class="about-note-icon" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h7a3 3 0 0 1 3 3v14a4 4 0 0 0-4-2H4ZM14 7a3 3 0 0 1 3-3h3v15h-3a4 4 0 0 0-3 2"/></svg></span><span><strong>近现代历史</strong></span></div>
  </div>
</section>
<% } %>
<%- partial('_partials/footprints') %>
