<% const album=ff_album(page); %>
<a class="back-link" href="<%= url_for('/album/') %>">← 所有相册</a>
<header class="page-heading illustrated-heading pointer-surface" data-pointer-light><span class="eyebrow">ALBUM</span><h1><%= album?.class_name || page.title %></h1><% if(album?.description) { %><p><%= album.description %></p><% } %><%- partial('_partials/heading-art',{kind:'album_detail'}) %></header>
<%- partial('life-nav') %>
<% if(album) { for(const {index:groupIndex,group} of ff_album_groups(album)) { %><section class="photo-section" id="photo-group-<%= groupIndex %>"><div class="section-heading"><h2><%= group.content %></h2><time><%= typeof group.date==='number'?group.date:date(group.date,'YYYY.MM.DD') %></time></div><div class="photo-grid"><% for(const [index,img] of (group.image||[]).entries()) { %><a id="photo-<%= groupIndex %>-<%= index %>" href="<%= ff_safe_url(img) %>" data-lightbox="<%= album.path_name %>" data-caption="<%= group.content %> · <%= index+1 %> / <%= group.image.length %>"><img src="<%= ff_safe_url(img) %>" alt="<%= group.content %> · 第 <%= index+1 %> 张" loading="lazy" decoding="async"></a><% } %></div></section><% } } else { %><p class="empty-state">这个相册还没有照片。</p><% } %>
