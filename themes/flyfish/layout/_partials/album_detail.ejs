<% const album=ff_album(page); const mapLinks=ff_album_map_links(album); %>
<a class="back-link" data-album-back="<%= album ? ff_album_category(album) : '' %>" href="<%= url_for('/album/') %>">← 所有相册</a>
<header class="page-heading illustrated-heading pointer-surface" data-pointer-light><span class="eyebrow">ALBUM</span><h1><%= album?.class_name || '这个相册暂未开放' %></h1><% if(album?.description) { %><p><%= album.description %></p><% } %><%- partial('_partials/heading-art',{kind:'album_detail'}) %></header>
<%- partial('life-nav') %>
<% if(album) { for(const {index:groupIndex,group} of ff_album_groups(album)) { %>
  <section class="photo-section" id="photo-group-<%= groupIndex %>">
    <div class="section-heading">
      <h2><%= group.content %></h2>
      <div class="photo-section-meta">
        <time><%= typeof group.date==='number'?group.date:date(group.date,'YYYY.MM.DD') %></time>
        <% if(mapLinks.has(groupIndex)) { %><a data-photo-map href="<%= mapLinks.get(groupIndex) %>">在地图上看</a><% } %>
      </div>
    </div>
    <div class="photo-grid">
      <% for(const [index,img] of (group.image||[]).entries()) { %>
        <a id="photo-<%= groupIndex %>-<%= index %>" href="<%= ff_safe_url(img) %>" data-lightbox="<%= album.path_name %>" data-photo-permalink data-caption="<%= group.content %> · <%= index+1 %> / <%= group.image.length %>"><img src="<%= ff_safe_url(img) %>" alt="<%= group.content %> · 第 <%= index+1 %> 张" loading="lazy" decoding="async"></a>
      <% } %>
    </div>
  </section>
<% } } else { %>
  <div class="empty-state"><p>这个地址暂时没有照片，可以去相册集看看其他记录。</p><a class="text-link" href="<%= url_for('/album/') %>">查看相册集</a></div>
<% } %>
