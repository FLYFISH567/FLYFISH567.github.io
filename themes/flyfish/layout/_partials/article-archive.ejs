<% const period = page.year ? page.year + ' 年' + (page.month ? ' ' + page.month + ' 月' : '') + (page.day ? ' ' + page.day + ' 日' : '') : '';
   const heading = page.tag ? '标签 · ' + page.tag : page.category ? '分类 · ' + page.category : period ? period + '归档' : '文章归档'; %>
<header class="page-heading"><h1><%= heading %><%= page.current > 1 ? ' · 第 ' + page.current + ' 页' : '' %></h1></header>
<%- partial('article-browse') %>
<% if(page.archive && !page.year && page.current===1 && site.posts.length) {
     const monthsByYear=new Map();
     for(const period of [...new Set(site.posts.map(post=>date(post.date,'YYYY/MM')))].sort().reverse()) {
       const [year,month]=period.split('/');
       if(!monthsByYear.has(year)) monthsByYear.set(year,[]);
       monthsByYear.get(year).push(month);
     } %>
  <nav class="archive-months" aria-label="按年月查看归档">
    <% for(const [year,months] of monthsByYear) { %>
      <div class="archive-year">
        <span><%= year %> 年</span>
        <ul role="list">
          <% for(const month of months) { %>
          <li><a href="<%= url_for('/archives/'+year+'/'+month+'/') %>" aria-label="<%= year %> 年 <%= Number(month) %> 月"><%= Number(month) %> 月</a></li>
          <% } %>
        </ul>
      </div>
    <% } %>
  </nav>
<% } %>
<%- partial('cards',{records:page.posts.toArray()}) %>
<% if(page.total>1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({prev_text:'← 上一页',next_text:'下一页 →',mid_size:1,end_size:1}) %></nav><% } %>
