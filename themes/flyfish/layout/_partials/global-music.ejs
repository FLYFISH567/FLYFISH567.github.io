<%# 这个播放器在站内内容切换时保留，音频元素不要放入 data-page-content。 %>
<aside class="music-dock" data-global-music data-id="<%= theme.music.id %>" data-server="<%= theme.music.server %>" data-api="<%= theme.music.api %>" data-playlist-url="<%= theme.music.playlist_url || '' %>" data-fallback-apis="<%= JSON.stringify(theme.music.fallback_apis || []) %>" data-playlists="<%= JSON.stringify(theme.music.playlists || []) %>" aria-label="随身音乐">
  <audio data-music-audio preload="none"></audio>
  <button class="music-dock-toggle" data-music-action="panel" aria-label="展开音乐控制台" aria-controls="music-controls" aria-expanded="false"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13M9 9l12-2"/><ellipse cx="6" cy="18" rx="3" ry="2.5"/><ellipse cx="18" cy="16" rx="3" ry="2.5"/></svg><span class="music-dock-levels" aria-hidden="true"><i></i><i></i><i></i></span></button>
  <section class="music-controls" id="music-controls" aria-label="音乐控制台" hidden>
    <header class="music-controls-header"><span>随身音乐</span><button type="button" data-music-action="close" aria-label="收起音乐控制台"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></header>
    <label class="music-playlist-picker" data-music-playlist-picker hidden><span>选择歌单</span><select data-music-playlist-select aria-label="随身音乐歌单"></select></label>
    <div class="music-current"><div class="music-cover"><img data-music-cover alt="" hidden><span aria-hidden="true">♪</span></div><div><strong data-music-title>随身音乐</strong><p data-music-artist></p></div></div>
    <div class="music-dock-links"><a class="music-library-link" href="<%= url_for('/music/') %>"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5v14M8 5v14M13 5v14M17 5l4 14"/></svg><span>打开音乐馆</span></a><a class="music-source-link" data-music-source href="https://music.163.com/#/playlist?id=<%= theme.music.id %>" target="_blank" rel="noopener"><span data-music-source-label>网易云收听</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3h7v7m0-7L10 14M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5"/></svg></a><button type="button" data-retry-music hidden>重试加载</button></div>
    <p class="music-live-status" data-music-status role="status" hidden></p>
    <label class="music-seek"><span class="sr-only">播放进度</span><input type="range" min="0" max="100" step="0.1" value="0" data-music-seek aria-label="播放进度" disabled></label><div class="music-time"><span data-music-elapsed>0:00</span><span data-music-duration>0:00</span></div>
    <div class="music-transport">
      <button type="button" data-music-action="loop" aria-label="列表循环，点击切换为单曲循环" title="列表循环"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m17 2 4 4-4 4M3 10V9a3 3 0 0 1 3-3h15M7 22l-4-4 4-4M21 14v1a3 3 0 0 1-3 3H3"/><path data-music-single-mark d="m10 10 2-2v8m-2 0h4" hidden/></svg><span class="sr-only" data-music-loop>列表循环</span></button>
      <button type="button" data-music-action="prev" aria-label="上一首" title="上一首"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5v14"/><path d="m18 5-10 7 10 7Z" fill="currentColor" stroke="none"/></svg></button>
      <button type="button" class="music-play-toggle" data-music-action="play" aria-label="播放歌曲" title="播放或暂停"><span data-music-play-icon aria-hidden="true">▶</span></button>
      <button type="button" data-music-action="next" aria-label="下一首" title="下一首"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 5v14"/><path d="m6 5 10 7-10 7Z" fill="currentColor" stroke="none"/></svg></button>
      <button type="button" data-music-action="mute" aria-label="静音" title="静音"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m11 5-6 4H2v6h3l6 4Z"/><path data-music-volume-waves d="M15 8a6 6 0 0 1 0 8M18 5a10 10 0 0 1 0 14"/><path data-music-muted-mark d="m16 9 6 6m0-6-6 6" hidden/></svg></button>
    </div>
    <div class="music-volume-row"><label><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 5-6 4H2v6h3l6 4ZM15 8a6 6 0 0 1 0 8M18 5a10 10 0 0 1 0 14"/></svg><span class="sr-only">音量</span><input type="range" min="0" max="1" step="0.05" value="0.5" data-music-volume aria-label="音量"></label></div>
  </section>
</aside>
