<div class="post-list">
<% for(const post of records) { const names=ff_tags(post); const label=ff_topic(post); const pattern=ff_life(post)?'life':/SQL/.test(label)?'database':label==='工具与经验'?'tools':/文件|目录/.test(label)?'folder':'code'; %>
  <article class="post-card<%= typeof dailyEntries!=='undefined' && dailyEntries ? ' daily-entry' : '' %>" data-pointer-light <%- typeof searchable!=='undefined' && searchable ? 'data-post-card' : '' %> data-title="<%= (post.title+' '+ff_summary(post)+' '+names.join(' ')).toLowerCase() %>" data-topics="<%= JSON.stringify(names) %>" data-kind="<%= ff_life(post)?'life':'study' %>" data-year="<%= date(post.date,'YYYY') %>" data-category="<%= post.categories.toArray().map(c=>c.name).join('|') %>">
    <a class="post-symbol <%= ff_life(post)?'life-symbol':'' %>" href="<%= ff_post_url(post.path) %>" aria-label="阅读 <%= post.title %>"><span><%= ff_life(post)?'小记':label==='工具与经验'?'工具':label.startsWith('PHP')?'PHP':label.replace('漏洞','').slice(0,8) %></span><small><%= ff_life(post)?'LIFE':'NOTES' %></small><%- partial('_partials/post-emblem',{pattern}) %></a>
    <div class="post-copy"><a class="post-topic" href="<%= url_for('/articles/?topic='+encodeURIComponent(names.includes(label)?label:names[0]||'')) %>"><%= label %></a><h2><a href="<%= ff_post_url(post.path) %>"><%= post.title %></a></h2><p><%= ff_summary(post) %></p><div class="post-meta"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date,'YYYY.MM.DD') %></time><% for(const tag of names.slice(0,2)) { %><a href="<%= url_for('/articles/?topic='+encodeURIComponent(tag)) %>"># <%= tag %></a><% } %></div></div>
  </article>
<% } %>
</div>
