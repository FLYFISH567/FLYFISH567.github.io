<section class="article-hub" data-article-hub data-search-index="<%= url_for('/search-index.json') %>" data-initial-topic="<%= page.tag ? (String(page.tag).toLowerCase()==='xss'?'XSS':page.tag) : '' %>" data-initial-category="<%= page.category || '' %>" data-initial-year="<%= page.year || '' %>" data-root="<%= config.root %>">
  <header class="page-heading illustrated-heading pointer-surface" data-pointer-light><span class="eyebrow">NOTES</span><h1>文章库</h1><%- partial('_partials/heading-art',{kind:'articles'}) %></header>
  <section class="library-controls pointer-surface" data-pointer-light aria-label="搜索与筛选">
  <div class="hub-controls"><label class="search-field"><span aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" focusable="false"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 4.5 4.5"/></svg></span><input type="search" name="q" placeholder="搜索标题、标签或正文" aria-label="搜索文章" title="按标题、摘要、标签或正文搜索"></label><label class="year-field"><span>年份</span><select name="year" aria-label="按年份筛选"><option value="">全部年份</option><% for(const year of [...new Set(ff_posts().map(p=>date(p.date,'YYYY')))]) { %><option><%= year %></option><% } %></select></label></div>
  <div class="topic-filters" role="group" aria-label="按专题筛选"><button type="button" data-topic="" aria-pressed="true">全部</button><% for(const t of ff_topics().slice(0,8)) { %><button type="button" data-topic="<%= t.name %>" aria-pressed="false"><%= t.name %><small><%= t.count %></small></button><% } %></div>
  <details class="more-topics"><summary>更多专题</summary><div class="topic-filters"><% for(const t of ff_topics().slice(8)) { %><button type="button" data-topic="<%= t.name %>" aria-pressed="false"><%= t.name %><small><%= t.count %></small></button><% } %></div></details>
  </section>
  <div class="filter-status"><p aria-live="polite" data-results-count>共 <%= site.posts.length %> 篇文章</p><button type="button" class="text-button" data-fulltext-retry hidden>重试全文搜索</button><button type="button" class="text-button" data-reset-filters>重置筛选</button></div>
  <%- partial('_partials/cards',{records:ff_posts(),searchable:true}) %><p class="empty-state" data-no-results hidden>没有找到匹配的文章。换个关键词，或者重置筛选试试。</p>
</section>
