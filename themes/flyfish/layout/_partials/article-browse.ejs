<nav class="article-browse" aria-label="浏览文章">
  <% const path=page.path.replace(/index\.html$/, '').replace(/^\//, '');
     for(const [section,label] of [['articles/','文章库'],['archives/','归档'],['categories/','分类'],['tags/','标签']]) { %>
  <a href="<%= url_for('/'+section) %>"<% if(path.startsWith(section)) { %> aria-current="<%= path===section?'page':'location' %>"<% } %>><%= label %></a>
  <% } %>
</nav>
