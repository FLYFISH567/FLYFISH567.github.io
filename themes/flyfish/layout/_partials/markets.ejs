<% const catalog=ff_markets(),snapshot=ff_market_snapshot(); %>
<section class="market-board pointer-surface" data-pointer-light data-markets aria-labelledby="markets-title">
  <script type="application/json" data-market-seed><%- JSON.stringify(snapshot).replaceAll('<','\\u003c') %></script>
  <div class="market-board-heading"><div><span class="eyebrow">AROUND THE MARKETS</span><h2 id="markets-title">环球市场</h2></div><div class="market-board-actions"><span data-market-status role="status">载入报价中</span><button type="button" class="text-button" data-market-refresh>刷新行情</button><button type="button" class="text-button" data-markets-toggle aria-expanded="true" aria-controls="market-board-content">收起</button></div></div>
  <div id="market-board-content" data-markets-content>
    <div class="market-board-toolbar"><div class="market-groups" role="group" aria-label="按地区查看行情"><button type="button" data-market-group="watch" aria-pressed="true">我的自选</button><% for(const group of catalog.GROUPS) { %><button type="button" data-market-group="<%= group.id %>" aria-pressed="false"><%= group.name %></button><% } %></div><button type="button" class="market-manage" data-market-manage aria-expanded="false" aria-controls="market-picker">管理自选 <span aria-hidden="true">＋</span></button></div>
    <form id="market-picker" class="market-picker" data-market-form hidden><div class="market-picker-heading"><strong>选择你想关注的市场</strong><button type="button" class="text-button" data-market-defaults>恢复精选</button></div><div class="market-choice-groups"><% for(const group of catalog.GROUPS) { %><fieldset><legend><%= group.name %></legend><% for(const item of catalog.MARKETS.filter(m=>m.group===group.id)) { %><label title="<%= item.description %>"><input type="checkbox" name="market" value="<%= item.id %>"><span><%= item.name %></span></label><% } %></fieldset><% } %></div><div class="market-picker-actions"><button type="submit" class="button primary">保存自选</button><button type="button" class="text-button" data-market-cancel>取消</button><p data-market-feedback role="status"></p></div></form>
    <div class="market-grid" data-market-grid aria-live="off"><% for(const id of catalog.DEFAULTS) { const item=catalog.byId(id),quote=snapshot.quotes[id]; %><article class="market-quote pointer-surface" data-pointer-light><div class="market-quote-heading"><h3><%= item.name %></h3><span><%= catalog.GROUPS.find(g=>g.id===item.group).short %></span></div><div class="market-price"><%= quote?quote.price.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}):'—' %><small><%= item.unit %></small></div><div class="market-change <%= quote&&quote.percent>0?'is-up':quote&&quote.percent<0?'is-down':'' %>"><%= quote?(quote.change>0?'+':'')+quote.change.toFixed(2)+'　'+(quote.percent>0?'+':'')+quote.percent.toFixed(2)+'%':'等待报价' %></div><footer><time <%- quote?'datetime="'+quote.quotedAt+'"':'' %>><%= quote?catalog.quoteTime(quote.quotedAt):'暂无时间' %></time></footer></article><% } %></div>
    <details class="market-board-footer market-information"><summary><span>报价时间 · 北京时间</span><span class="market-information-label">数据来源<span class="market-information-state" aria-hidden="true"></span></span></summary>
      <div class="market-source-content">
        <div class="market-provider-grid"><a href="https://gu.qq.com/" target="_blank" rel="noopener noreferrer" class="market-provider"><strong>腾讯财经</strong><span>A 股、港股、美股指数</span></a><a href="https://wallstreetcn.com/" target="_blank" rel="noopener noreferrer" class="market-provider"><strong>华尔街见闻</strong><span>日本、韩国、黄金</span></a></div>
        <dl class="market-data-rules"><div><dt>更新频率</dt><dd>页面可见且行情展开时，每分钟检查</dd></div><div><dt>报价时间</dt><dd>采用来源时间，统一显示为北京时间</dd></div><div><dt>休市与延迟</dt><dd>保留最近一次报价和原时间</dd></div></dl>
      </div>
    </details>
  </div>
</section>
