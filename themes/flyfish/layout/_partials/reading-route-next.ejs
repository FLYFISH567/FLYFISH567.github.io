<% for(const route of ff_reading_routes()) {
     const index=route.steps.findIndex(step=>step.source===page.source);
     if(index===-1) continue;
     const next=route.steps[index+1]; %>
<nav class="reading-route-next" aria-label="<%= route.title %>阅读路线">
  <a class="reading-route-overview" href="<%= url_for('/articles/') %>#reading-route-<%= route.id %>"><%= route.title %> <span>第 <%= index+1 %> 步，共 <%= route.steps.length %> 步</span></a>
  <% if(next) { %>
  <a class="reading-route-continue" data-reading-route-next href="<%= next.href %>"><small>本系列下一步</small><strong><%= next.title %></strong></a>
  <% } %>
</nav>
<% } %>
